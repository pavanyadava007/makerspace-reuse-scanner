POSTGRES_USER=mrs
POSTGRES_PASSWORD=mrs
POSTGRES_DB=mrs
DATABASE_URL=postgresql+psycopg://mrs:mrs@db:5432/mrs
API_URL=http://api:8000
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
WITH_VLM=0                      # 1 → build api image with CLIP material stage (adds CPU torch, ~1 GB)
# Edge node - every EDGE_* variable overrides the same key in edge/config.yaml (see edge/settings.py)
EDGE_DEVICE=auto                # label for FPS numbers; auto = detect Pi/Jetson/GPU/CPU
EDGE_CONFIG=config.yaml
EDGE_MODEL=/models/yolo11n_makerspace.onnx
EDGE_CLASSES=/models/classes.yaml
EDGE_CAMERA=0                   # index, /dev/video path or RTSP URL
EDGE_IMGSZ=640
EDGE_MIN_CONF=0.35
